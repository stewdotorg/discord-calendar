# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here
DISCORD_PUBLIC_KEY=your_public_key_here
DISCORD_GUILD_ID=your_guild_id_here
# Notification targets for bot lifecycle events.
# Comma-separated list of channel IDs and/or user IDs.
# Prefix "u:" for user DM, "c:" for channel message.
# Example: DISCORD_NOTIFY_TARGETS=u:123456789,c:987654321
DISCORD_NOTIFY_TARGETS=

# Events to notify on. Comma-separated: restart,shutdown,error,deploy.
# Default if unset: restart,shutdown,error
# DISCORD_NOTIFY_EVENTS=restart,shutdown,error

# Enable the message_content privileged intent (DM reply handling, RSVP, notify DMs).
# Set to "true" in dev; leave unset (or "false") in prod until the intent is approved.
# When disabled, user-DM notification targets are skipped; channel targets are unaffected.
DISCORD_ENABLE_MESSAGE_CONTENT=true

# Google Calendar
# Preferred: OAuth2 user credentials (enables attendee management)
# Run scripts/setup_oauth.py once to generate the refresh token.
GOOGLE_CLIENT_SECRET_FILE=./client-secret.json
GOOGLE_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_CALENDAR_ID=your_calendar_id_here

# Legacy: service account (cannot manage attendees)
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Autocomplete
# How many days ahead to show events in autocomplete dropdowns
AUTOCOMPLETE_LOOKAHEAD_DAYS=90
